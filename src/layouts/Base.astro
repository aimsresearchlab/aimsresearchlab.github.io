---
import '@fontsource/tinos';        // Times-metric serif, weight 400
import '@fontsource/tinos/700.css'; // bold for headings
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  socialTitle?: string; // short title for link previews; defaults to title
  description?: string;
  image?: string;       // path under /public for the social preview; 1200x630 jpg
  type?: 'website' | 'article';
}
const {
  title = 'AIMS',
  socialTitle = title,
  description = 'AIMS (Artificial Intelligence & Multimodal Systems) is a research group at the University of Southern Mississippi working on computer vision, vision-language models, RAG and conversational memory, AI agents, and trustworthy AI.',
  image = '/og.jpg',
  type = 'website',
} = Astro.props;

// Absolute URLs for canonical + social tags. Astro.site comes from astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;

// Organization schema for the lab (rich results, knowledge panel hints).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ResearchOrganization',
  name: 'AIMS: Artificial Intelligence & Multimodal Systems Lab',
  alternateName: 'AIMS Lab',
  url: Astro.site?.href,
  logo: new URL('/logo-mark.svg', Astro.site).href,
  description,
  parentOrganization: {
    '@type': 'CollegeOrUniversity',
    name: 'University of Southern Mississippi',
    url: 'https://www.usm.edu/',
  },
  location: {
    '@type': 'Place',
    name: 'TEC 340, University of Southern Mississippi',
    address: { '@type': 'PostalAddress', addressLocality: 'Hattiesburg', addressRegion: 'MS', addressCountry: 'US' },
  },
  sameAs: ['https://github.com/aimsresearchlab'],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="v0j-QlcX-f0QGCc_REz9tnTLZ4U0cbaE5oUf1sDgmw0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1652EC" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph (Facebook, LinkedIn, Slack, iMessage previews) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="AIMS Lab" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The AIMS lab space at the University of Southern Mississippi" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header />
    <main class="container">
      <slot />
    </main>
    <Footer />
  </body>
</html>
