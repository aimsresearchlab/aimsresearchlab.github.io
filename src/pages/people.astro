---
import Base from '../layouts/Base.astro';
import Person from '../components/Person.astro';
import { groupedPeople, alumni } from '../data/people';

const peopleGroups = groupedPeople();
const alumniGroups = alumni();
---
<Base
  title="People · AIMS Lab"
  description="Faculty, graduate students, and undergraduate researchers in the AIMS lab at the University of Southern Mississippi."
>
  <section class="wide">
    <h1>People</h1>
    <p class="lede">
      The lab is in TEC 340 at the University of Southern Mississippi. We take
      on undergraduate researchers every semester.
    </p>
    {peopleGroups.map((group) => (
      <div class="people-group">
        <h2 class="group-label ui">{group.label}</h2>
        <ul class="people">
          {group.members.map((person) => <Person person={person} />)}
        </ul>
      </div>
    ))}
  </section>

  {alumniGroups.length > 0 && (
    <section class="wide alumni">
      <h2>Alumni</h2>
      {alumniGroups.map((group) => (
        <div class="people-group">
          <h3 class="group-label ui">{group.label}</h3>
          <ul class="people">
            {group.members.map((person) => <Person person={person} />)}
          </ul>
        </div>
      ))}
    </section>
  )}
</Base>

<style>
  .lede { font-size: 1.15rem; color: var(--ink-soft); margin: 0 0 3rem; max-width: 42rem; }
  .people-group + .people-group { margin-top: 3rem; }
  .group-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    font-weight: 600;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.5rem;
    margin: 0 0 1.75rem;
  }
  .people {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem 1.5rem;
  }
  .people :global(.person) { flex: 0 0 11.25rem; }
  .alumni { border-top: 1px solid var(--rule); padding-top: 2rem; }
  .alumni h2 { margin-top: 0; }
</style>
