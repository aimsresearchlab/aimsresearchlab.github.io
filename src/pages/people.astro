    main{max-width:var(--max);margin:auto;padding:3.5rem 1.5rem 5.5rem}.section{margin-bottom:5.5rem}.section-head{display:flex;align-items:end;justify-content:space-between;gap:2rem;border-bottom:1px solid #cfd5df;padding-bottom:1.1rem;margin-bottom:2rem}.section-head h2{font-family:'Times New Roman',Times,serif;font-size:clamp(2.1rem,4vw,3.2rem);margin:0}.section-head span{color:var(--muted);font-size:.82rem;text-transform:uppercase;letter-spacing:.13em;font-weight:700}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem}.card{background:var(--white);border:1px solid var(--line);border-radius:18px;overflow:hidden;transition:transform .25s ease,box-shadow .25s ease}.card:hover{transform:translateY(-4px);box-shadow:0 18px 44px rgba(7,20,45,.10)}.card.featured{grid-column:span 2;display:grid;grid-template-columns:43% 1fr}.portrait-wrap{aspect-ratio:4/3;background:#d9dee8;overflow:hidden}.portrait{width:100%;height:100%;object-fit:cover;filter:saturate(.88);transition:transform .45s ease}.card:hover .portrait{transform:scale(1.025)}.featured .portrait-wrap{aspect-ratio:auto;min-height:360px}.content{padding:1.45rem}.featured .content{padding:2.2rem;display:flex;flex-direction:column;justify-content:center}.role{color:#967100;font-size:.72rem;text-transform:uppercase;letter-spacing:.13em;font-weight:800;margin-bottom:.5rem}.name{font-family:"Source Serif 4",Georgia,serif;font-size:1.48rem;line-height:1.15;margin:0 0 .45rem}.featured .name{font-size:2.25rem}.topic{color:var(--muted);font-size:.9rem;margin:0}.links{display:flex;gap:.55rem;margin-top:1.15rem}.links a{border:1px solid var(--line);border-radius:999px;padding:.42rem .72rem;font-size:.72rem;font-weight:700}.links a:hover{background:var(--navy);border-color:var(--navy);color:#fff}.intro-card{background:var(--gold);border-radius:18px;padding:2rem;display:flex;flex-direction:column;justify-content:space-between;min-height:360px}.intro-card .kicker{font-size:.75rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.intro-card p{font-family:"Source Serif 4",Georgia,serif;font-size:1.65rem;line-height:1.23;margin:1rem 0;color:#101b31}.intro-card a{align-self:flex-start;border-bottom:2px solid var(--navy);font-weight:800;font-size:.85rem;padding-bottom:.15rem}
