---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { people, groupedPeople, alumni } from '../data/people';
import type { LinkType, Person, Category } from '../data/people';

// The director gets the featured card at the top; the rest of the roster keeps
// the grouped list below it.
const featured = people.filter((p) => p.bio && !p.graduated);
const featuredNames = new Set(featured.map((p) => p.name));
const peopleGroups = groupedPeople()
  .map((g) => ({ ...g, members: g.members.filter((m) => !featuredNames.has(m.name)) }))
  .filter((g) => g.members.length > 0);
const alumniGroups = alumni();

const linkHref = (type: LinkType, url: string) =>
  type === 'email' ? `mailto:${url}` : url;

// Section heading, count line, and card kicker for each roster category.
const heading: Record<Category, string> = {
  faculty: 'Faculty',
  phd: 'Doctoral Researchers',
  masters: "Master's Researchers",
  undergrad: 'Undergraduate Researchers',
};
const role: Record<Category, string> = {
  faculty: 'Faculty',
  phd: 'PhD Researcher',
  masters: "Master's Researcher",
  undergrad: 'Undergraduate Researcher',
};
const count = (members: Person[]) => {
  const n = members.length;
  const noun = n === 1 ? 'student' : 'students';
  return members[0]?.category === 'phd' ? `${n} PhD ${noun}` : `${n} ${noun}`;
};
const initials = (name: string) =>
  name.split(' ').map((w) => w[0]).slice(0, 2).join('');

// Text labels for the link pills. The director's website is her USM profile.
const linkLabel: Record<LinkType, string> = {
  website: 'Website',
  scholar: 'Google Scholar',
  github: 'GitHub',
  x: 'X',
  linkedin: 'LinkedIn',
  email: 'Email',
};
---
<Base
  title="People · AIMS Lab"
  description="Faculty, graduate students, and undergraduate researchers in the AIMS lab at the University of Southern Mississippi."
>
  <PageHeader title="People">
    <p class="lede">
      The lab is in TEC 340 at the University of Southern Mississippi. We take
      on undergraduate researchers every semester.
    </p>
  </PageHeader>
  <section class="wide">
    <div class="section-head">
      <h2>Leadership</h2>
      <span class="ui">Faculty</span>
    </div>

    <div class="leadership">
      {featured.map((person) => (
        <article class="featured">
          <div class="portrait-wrap">
            <img class="portrait" src={person.image} alt={person.name} width="192" height="192" />
          </div>
          <div class="featured-body">
            <p class="role ui">{person.role}</p>
            <h3 class="featured-name">{person.name}</h3>
            <p class="featured-bio">{person.bio}</p>
            {person.links && person.links.length > 0 && (
              <p class="featured-links ui">
                {person.links.map((l) => (
                  <a href={linkHref(l.type, l.url)}>{l.type === 'website' ? 'USM Profile' : linkLabel[l.type]}</a>
                ))}
              </p>
            )}
          </div>
        </article>
      ))}

      <aside class="culture">
        <p class="kicker ui">Our culture</p>
        <p class="culture-quote">
          Research is a team practice. Graduate and undergraduate researchers
          work side by side, with close mentorship and room to own ambitious
          ideas.
        </p>
        <a class="join-link ui" href="mailto:rabab.abdelfattah@usm.edu?subject=Interest%20in%20joining%20AIMS%20Lab">Work with us</a>
      </aside>
    </div>

    {peopleGroups.map((group) => (
      <div class="people-group">
        <div class="section-head">
          <h2>{heading[group.members[0].category]}</h2>
          <span class="ui">{count(group.members)}</span>
        </div>
        <ul class="cards">
          {group.members.map((person) => (
            <li class="card">
              <div class="card-photo">
                {person.image ? (
                  <img src={person.image} alt={person.name} width="192" height="192" loading="lazy" />
                ) : (
                  <span class="initials ui" aria-hidden="true">{initials(person.name)}</span>
                )}
              </div>
              <div class="card-body">
                <p class="role ui">{role[person.category]}</p>
                <h3 class="card-name">{person.name}</h3>
                <p class="card-topic">{person.topic}</p>
                {person.links && person.links.length > 0 && (
                  <p class="featured-links ui">
                    {person.links.map((l) => <a href={linkHref(l.type, l.url)}>{linkLabel[l.type]}</a>)}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  {alumniGroups.length > 0 && (
    <section class="wide alumni">
      <h2>Alumni</h2>
      {alumniGroups.map((group) => (
        <div class="people-group">
          <h3 class="group-label ui">{group.label}</h3>
          <ul class="cards">
            {group.members.map((person) => (
              <li class="card">
                <div class="card-photo">
                  {person.image ? (
                    <img src={person.image} alt={person.name} width="192" height="192" loading="lazy" />
                  ) : (
                    <span class="initials ui" aria-hidden="true">{initials(person.name)}</span>
                  )}
                </div>
                <div class="card-body">
                  <p class="role ui">{role[person.category]}</p>
                  <h3 class="card-name">{person.name}</h3>
                  <p class="card-topic">{person.topic}</p>
                  {person.links && person.links.length > 0 && (
                    <p class="featured-links ui">
                      {person.links.map((l) => <a href={linkHref(l.type, l.url)}>{linkLabel[l.type]}</a>)}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
  )}
</Base>

<style>
  .lede { font-size: 1.15rem; color: var(--ink-soft); margin: 0 0 3rem; max-width: 42rem; }
  .people-group + .people-group { margin-top: 3rem; }
  .group-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    font-weight: 600;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.5rem;
    margin: 0 0 1.75rem;
  }
  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .card {
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 18px;
    overflow: hidden;
  }
  .card-photo { aspect-ratio: 4 / 3; background: var(--rule); }
  .card-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .initials {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--ink-soft);
    font-size: 2.4rem;
    font-weight: 700;
  }
  .card-body { padding: 1.45rem; }
  .card-name { margin: 0 0 0.45rem; font-size: 1.48rem; line-height: 1.15; }
  .card-topic { margin: 0; color: var(--ink-soft); font-size: 0.9rem; }
  .alumni { border-top: 1px solid var(--rule); padding-top: 2rem; }
  .alumni h2 { margin-top: 0; }
  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1.1rem;
    margin: 3rem 0 2rem;
  }
  .section-head h2 { margin: 0; font-size: clamp(2.1rem, 4vw, 3.2rem); }
  .section-head span {
    color: var(--ink-soft);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-weight: 600;
  }

  .leadership {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 1.25rem;
    margin-bottom: 3.5rem;
  }

  .featured {
    display: grid;
    grid-template-columns: 43% 1fr;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 18px;
    overflow: hidden;
  }
  .portrait-wrap { background: var(--rule); min-height: 22rem; }
  .portrait { display: block; width: 100%; height: 100%; object-fit: cover; }
  .featured-body {
    padding: 2.2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .role {
    color: var(--gold-ink);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-weight: 700;
    margin: 0 0 0.5rem;
  }
  .featured-name { margin: 0 0 0.45rem; font-size: 2.25rem; line-height: 1.15; }
  .featured-bio { margin: 0; color: var(--ink-soft); font-size: 0.95rem; }
  .featured-links { display: flex; flex-wrap: wrap; gap: 0.55rem; margin: 1.15rem 0 0; }
  .featured-links a {
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.42rem 0.72rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ink);
  }
  .featured-links a:hover { background: var(--navy); border-color: var(--navy); color: #fff; }

  .culture {
    background: var(--gold);
    border-radius: 18px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .kicker {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0;
  }
  .culture-quote {
    font-size: 1.65rem;
    line-height: 1.23;
    margin: 1rem 0;
    color: var(--ink);
  }
  .join-link {
    align-self: flex-start;
    border-bottom: 2px solid var(--ink);
    padding-bottom: 0.15rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink);
  }

  @media (max-width: 60rem) {
    .leadership { grid-template-columns: 1fr; }
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 40rem) {
    .featured { grid-template-columns: 1fr; }
    .portrait-wrap { min-height: 0; aspect-ratio: 4 / 3; }
    .featured-body { padding: 1.75rem; }
    .cards { grid-template-columns: 1fr; }
  }
</style>
