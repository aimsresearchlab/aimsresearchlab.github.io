---
// Self-contained, same pattern as what-is-aims.astro and people.astro:
// header, hero, and footer are written directly here. The news list itself
// still needs real data, so this keeps the two imports and the grouping
// logic from the original file.
import { news, formatDate } from '../data/news';

const sorted = [...news].sort((a, b) => b.date.localeCompare(a.date));
const byYear = new Map<string, typeof news>();
for (const item of sorted) {
  const year = item.date.slice(0, 4);
  byYear.set(year, [...(byYear.get(year) ?? []), item]);
}
const years = [...byYear.entries()];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>News · AIMS Lab</title>
  <meta name="description" content="Acceptances, preprints, talks, awards, and new members of the AIMS lab at the University of Southern Mississippi.">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%2308142b'/%3E%3Cpath d='M14 44 28 17h8l14 27h-9l-3-7H25l-3 7Zm14-14h7l-3.5-8Z' fill='%23ffcc33'/%3E%3C/svg%3E">
  <style>
    :root{--navy:#07142d;--gold:#ffcc33;--cream:#efefec;--ink:#12203a;--muted:#68738a;--line:#d8d9d6;--white:#fff;--blue:#1652ec;--charcoal:#302f2c;--max:1180px}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font-family:'Times New Roman',Times,serif;font-size:16px;line-height:1.75}a{color:inherit;text-decoration:none}img{display:block;max-width:100%}
    .topbar{background:#fff;color:var(--navy);border-bottom:1px solid var(--line)}.nav{max-width:var(--max);margin:auto;padding:.75rem 1.5rem;display:flex;align-items:center;gap:2rem}.brand-lockup{display:flex;align-items:center;gap:1rem;margin-right:auto}.usm-brand,.aims-brand{display:flex;align-items:center;justify-content:center;height:70px}.usm-logo{width:150px;height:auto}.brand-divider{height:52px;width:1px;background:#b9bec8}.brand-full{width:auto;height:70px}.navlinks{display:flex;gap:.3rem;font-size:1.05rem;font-weight:700}.navlinks a{display:inline-block;padding:.5rem 1rem;border-radius:.4rem;color:var(--muted)}.navlinks a[aria-current=page]{background:#111;color:#fff}.navlinks a:hover{color:var(--navy)}
    .hero{background:var(--charcoal);color:#fff;border-bottom:5px solid var(--gold)}.hero-inner{max-width:var(--max);margin:auto;padding:2.2rem 1.5rem 2rem}.hero h1{color:#fff!important;font-family:'Times New Roman',Times,serif;letter-spacing:-.045em;line-height:1.05;font-size:clamp(2.25rem,4vw,3.25rem);margin:.5rem 0}.hero p{font-size:1.15rem;max-width:760px;color:#d6d5d0;margin:0}
    main{max-width:var(--max);margin:auto;padding:3.5rem 1.5rem 5.5rem}
    .year-section{margin-bottom:3rem}.year-section h2{font-family:'Times New Roman',Times,serif;letter-spacing:-.02em;font-size:clamp(1.6rem,3vw,2.1rem);margin:0 0 1.1rem;padding-bottom:.65rem;border-bottom:1px solid var(--line)}
    .news-list{list-style:none;margin:0;padding:0}.news-list li{display:grid;grid-template-columns:8.5rem minmax(0,1fr);gap:1rem;padding:.9rem 0;border-bottom:1px solid var(--line)}.news-list time{font-size:.9rem;color:var(--muted)}.news-text{line-height:1.6}.news-text a{color:var(--ink);text-decoration:none}.news-text a:hover{color:var(--blue)}
    footer{background:#040d1f;color:#aeb8ca}.footer{max-width:var(--max);margin:auto;padding:2.2rem 1.5rem;display:flex;justify-content:space-between;gap:2rem;font-size:.78rem}.footer a{color:#fff}
    @media(max-width:900px){.nav{align-items:flex-start;flex-wrap:wrap}.brand-lockup{margin-right:auto}.navlinks{order:3;width:100%;overflow-x:auto;padding-top:.2rem}}
    @media(max-width:650px){.nav{gap:1rem}.brand-lockup{gap:.65rem}.usm-brand,.aims-brand{height:50px}.brand-full{width:auto;height:49px}.brand-divider{height:42px}.usm-logo{width:105px}.navlinks{gap:.2rem;font-size:.85rem}.navlinks a{padding:.35rem .65rem}.hero-inner{padding:1.75rem 1.25rem}main{padding:3.2rem 1rem 4rem}.news-list li{grid-template-columns:1fr;gap:.15rem}.footer{flex-direction:column}}
  </style>
</head>
<body>
  <header class="topbar">
    <nav class="nav" aria-label="Primary navigation">
      <div class="brand-lockup">
  <a class="aims-brand" href="https://aimsresearchlab.com/"><img class="brand-full" src="/assets/aims-lab-logo.png" alt="AIMS Lab — Artificial Intelligence and Multimodal Systems"></a>
</div>
      <div class="navlinks">
        <a href="/">Home</a>
        <a href="/what-is-aims/">What is AIMS?</a>
        <a href="/projects/">Projects</a>
        <a href="/people/">Meet the Team</a>
        <a href="/news/" aria-current="page">News</a>
        <a href="/publications/">Publications</a>
      </div>
    </nav>
  </header>

  <section class="hero">
    <div class="hero-inner">
      <h1>News</h1>
      <p>Acceptances, preprints, talks, awards, and new members of the AIMS lab at the University of Southern Mississippi.</p>
    </div>
  </section>

  <main>
    {years.map(([year, items]) => (
      <section class="year-section">
        <h2>{year}</h2>
        <ol class="news-list">
          {items.map((item) => (
            <li>
              <time datetime={item.date}>{formatDate(item.date)}</time>
              <span class="news-text">
                {item.url ? <a href={item.url}>{item.text}</a> : item.text}
              </span>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </main>

  <footer><div class="footer"><span>© {new Date().getFullYear()} AIMS Lab · University of Southern Mississippi</span><span><a href="https://github.com/aimsresearchlab">GitHub</a> · TEC 340, Hattiesburg, MS</span></div></footer>
</body>
</html>
