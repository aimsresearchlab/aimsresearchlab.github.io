---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import Publication from '../components/Publication.astro';
import Person from '../components/Person.astro';
import { recentPublications } from '../data/publications';
import { groupedPeople } from '../data/people';
import { recentNews, formatDate } from '../data/news';
import { projects } from '../data/projects';

const recent = recentPublications(3);
const peopleGroups = groupedPeople();
const newsItems = recentNews(5);

// Research areas shown as a tag row under the intro. Edit here.
const areas = [
  'ComputerVision',
  'VisionLanguageModels',
  'RAG',
  'ConversationalMemory',
  'AIAgents',
  'TrustworthyAI',
  'HumanCenteredAI',
];

// Project link kinds -> icon + label. Simple Icons for brand marks, Phosphor otherwise.
// Brand marks keep their official colors (arXiv red, GitHub black).
const linkMeta = {
  arxiv:  { icon: 'simple-icons:arxiv',  label: 'arXiv',  color: '#B31B1B' },
  github: { icon: 'simple-icons:github', label: 'GitHub', color: '#181717' },
  paper:  { icon: 'ph:file-text',        label: 'Paper',  color: 'currentColor' },
} as const;
---
<Base title="AIMS Lab · Artificial Intelligence & Multimodal Systems · USM" socialTitle="AIMS Lab: Artificial Intelligence & Multimodal Systems at USM">
  <!-- Hero: wide banner, then intro on the left and the news feed on the right -->
  <section id="top" class="hero wide">
    <img class="banner" src="/lab.webp" alt="The AIMS lab space at USM" width="1600" height="640" />
    <div class="hero-grid">
      <div class="intro">
        <h1>AIMS</h1>
        <p class="expansion">
          <span class="cap">A</span>rtificial <span class="cap">I</span>ntelligence &amp;
          <span class="cap">M</span>ultimodal <span class="cap">S</span>ystems
        </p>
        <p class="affil ui">Lab @ USM · CSCE</p>
        <p class="lede">
          A research group at the University of Southern Mississippi building AI
          systems that learn from images, video, text, speech, and sensor data, and
          stay reliable under uncertainty.
        </p>
        <p class="areas ui" aria-label="Research areas">
          {areas.map((a) => <a class="area-pill" href="#projects">#{a}</a>)}
        </p>
      </div>
      <!-- News (pulled from src/data/news.ts) -->
      <aside id="news" class="news" aria-labelledby="news-heading">
        <h2 id="news-heading" class="news-heading ui">News</h2>
        <ol class="news-list">
          {newsItems.map((item) => (
            <li>
              <time class="ui" datetime={item.date}>{formatDate(item.date)}</time>
              <span class="news-text">
                {item.url ? <a href={item.url}>{item.text}</a> : item.text}
              </span>
            </li>
          ))}
        </ol>
      </aside>
    </div>
  </section>

  <!-- Projects (pulled from src/data/projects.ts) -->
  <section id="projects" class="wide">
    <h2>Projects</h2>
    <div class="projects">
      {projects.map((proj) => (
        <article class="project">
          <h3>{proj.title}</h3>
          <p class="claim">{proj.claim}</p>
          <p class="tags ui">
            {proj.tags.map((t) => <span class="tag">#{t}</span>)}
          </p>
          <p class="project-links ui">
            {proj.links.map((l) => (
              <a href={l.url} class="link-pill">
                <Icon name={linkMeta[l.kind].icon} style={`color: ${linkMeta[l.kind].color}`} />
                {linkMeta[l.kind].label}
              </a>
            ))}
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- People (grouped by category, pulled from src/data/people.ts) -->
  <section id="people" class="wide">
    <h2>People</h2>
    {peopleGroups.map((group) => (
      <div class="people-group">
        <h3 class="group-label ui">{group.label}</h3>
        <ul class="people">
          {group.members.map((person) => <Person person={person} />)}
        </ul>
      </div>
    ))}
  </section>

  <!-- Recent publications (pulled from src/data/publications.ts) -->
  <section id="recent" class="wide">
    <div class="section-head">
      <h2>Recent</h2>
      <a class="ui see-all" href="/publications">All publications →</a>
    </div>
    {recent.map((pub) => <Publication pub={pub} />)}
  </section>
</Base>

<style>
  .hero { padding-top: 1rem; }
  .banner {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 2;
    object-fit: cover;
    border: 1px solid var(--rule);
    margin-bottom: 2.5rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: 3rem;
    align-items: start;
  }
  @media (max-width: 56rem) {
    .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
  .hero h1 { margin-top: 0; margin-bottom: 0.25rem; }
  .expansion {
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
    color: var(--ink);
  }
  .expansion .cap { color: var(--brand); font-weight: 700; }
  .affil {
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 1.5rem;
  }
  .lede { font-size: 1.2rem; color: var(--ink-soft); margin-bottom: 0; }
  .areas { margin: 1.75rem 0 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .area-pill {
    display: inline-block;
    background: var(--brand);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    border-radius: 999px;
    padding: 0.4rem 0.95rem;
    line-height: 1.2;
  }
  .area-pill:hover { background: var(--brand-deep); color: #fff; }

  /* News feed: a dated list in the right column */
  .news { border-left: 2px solid var(--brand); padding-left: 1.25rem; }
  .news-heading {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    font-weight: 600;
    margin: 0 0 1rem;
  }
  .news-list { list-style: none; margin: 0; padding: 0; }
  .news-list li { display: flex; flex-direction: column; gap: 0.1rem; }
  .news-list li + li { margin-top: 0.9rem; }
  .news-list time { font-size: 0.8rem; color: var(--ink-soft); }
  .news-text { font-size: 1rem; line-height: 1.45; }
  .news-text a { color: var(--ink); text-decoration: none; }
  .news-text a:hover { color: var(--brand); }

  /* Projects: a card grid in the wide column */
  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1.5rem;
  }
  .project {
    border: 1px solid var(--rule);
    padding: 1.25rem 1.4rem 1.1rem;
    display: flex;
    flex-direction: column;
  }
  .project h3 { margin: 0 0 0.4rem; }
  .claim { margin: 0 0 0.9rem; color: var(--ink-soft); font-size: 1rem; line-height: 1.5; flex: 1; }
  .tags { margin: 0 0 0.9rem; display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .tag { font-size: 0.8rem; color: var(--brand-deep); }
  .tags .tag + .tag { margin-left: 0.5rem; }
  .project-links { margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .link-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--brand);
    text-decoration: none;
    border: 1px solid var(--brand);
    border-radius: 0.3rem;
    padding: 0.25rem 0.65rem;
  }
  .link-pill:hover { background: var(--paper); border-color: var(--brand-deep); color: var(--brand-deep); }
  .link-pill [data-icon] { font-size: 1rem; }

  .people-group + .people-group { margin-top: 2.5rem; }
  .group-label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    font-weight: 600;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.5rem;
    margin-bottom: 1.75rem;
  }
  .people {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem 1.5rem;
  }
  .people :global(.person) { flex: 0 0 10.5rem; } /* fixed width, left-aligned; wide enough for two-word names on one line */

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .see-all { font-size: 0.9rem; white-space: nowrap; }
</style>
