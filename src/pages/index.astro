---
import Base from '../layouts/Base.astro';
import Publication from '../components/Publication.astro';
import Person from '../components/Person.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { recentPublications } from '../data/publications';
import { groupedPeople } from '../data/people';
import { recentNews, formatDate } from '../data/news';
import { featuredProjects } from '../data/projects';

const recent = recentPublications(3);
const peopleGroups = groupedPeople();
const newsItems = recentNews(5);
const projects = await featuredProjects(3); // one row; raise to 6 for two rows

// Research areas shown as a tag row under the intro. Edit here.
const areas = [
  'ComputerVision',
  'VisionLanguageModels',
  'RAG',
  'ConversationalMemory',
  'AIAgents',
  'TrustworthyAI',
  'HumanCenteredAI',
];
---
<Base title="AIMS Lab · Artificial Intelligence & Multimodal Systems · USM" socialTitle="AIMS Lab: Artificial Intelligence & Multimodal Systems at USM">
  <!-- Hero: wide banner, then intro on the left and the news feed on the right -->
  <section id="top" class="hero wide">
    <img class="banner" src="/lab.webp" alt="The AIMS lab space at USM" width="1600" height="640" />
    <div class="hero-grid">
      <div class="intro">
        <h1>AIMS Research Lab</h1>
        <p class="expansion">
          <span class="cap">A</span>rtificial <span class="cap">I</span>ntelligence &amp;
          <span class="cap">M</span>ultimodal <span class="cap">S</span>ystems
        </p>
        <p class="affil ui">Lab @ USM · CSCE · TEC 340</p>
        <p class="lede">
          A research group at the University of Southern Mississippi building AI
          systems that learn from images, video, text, speech, and sensor data, and
          stay reliable under uncertainty.
        </p>
        <p class="areas ui" aria-label="Research areas">
          {areas.map((a) => <a class="area-pill" href="#projects">#{a}</a>)}
        </p>
        <!-- Join card: the /people culture card's message, so the left column
             carries as much as the news panel beside it. -->
        <aside class="join">
          <p class="join-kicker ui">Join the lab</p>
          <p class="join-quote">
            Research is a team practice. Graduate and undergraduate researchers
            work side by side, with close mentorship and room to own ambitious
            ideas.
          </p>
          <p class="join-note">We take on undergraduate researchers every semester.</p>
          <a class="join-link ui" href="mailto:rabab.abdelfattah@usm.edu?subject=Interest%20in%20joining%20AIMS%20Lab">Work with us →</a>
        </aside>
      </div>
      <!-- News (pulled from src/data/news.ts) -->
      <aside id="news" class="news" aria-labelledby="news-heading">
        <h2 id="news-heading" class="news-heading ui">
          News <a class="news-all" href="/news/">All →</a>
        </h2>
        <ol class="news-list">
          {newsItems.map((item) => (
            <li>
              <time class="ui" datetime={item.date}>{formatDate(item.date)}</time>
              <span class="news-text">
                {item.url ? <a href={item.url}>{item.text}</a> : item.text}
              </span>
            </li>
          ))}
        </ol>
      </aside>
    </div>
  </section>

  <!-- Projects (first three, by `featured` in src/content/projects/*.md) -->
  <section id="projects" class="wide">
    <div class="section-head">
      <h2>Projects</h2>
      <a class="ui see-all" href="/projects/">All projects →</a>
    </div>
    <div class="projects">
      {projects.map((project, i) => <ProjectCard project={project} cover lead={i === 0} />)}
    </div>
  </section>

  <!-- People (grouped by category, pulled from src/data/people.ts) -->
  <section id="people" class="wide">
    <div class="section-head">
      <h2>People</h2>
      <a class="ui see-all" href="/people/">Everyone →</a>
    </div>
    {peopleGroups.map((group) => (
      <div class="people-group">
        <h3 class="group-label ui">{group.label}</h3>
        <ul class="people">
          {group.members.map((person) => <Person person={person} />)}
        </ul>
      </div>
    ))}
  </section>

  <!-- Recent publications (pulled from src/data/publications.ts) -->
  <section id="recent" class="wide">
    <div class="section-head">
      <h2>Recent</h2>
      <a class="ui see-all" href="/publications">All publications →</a>
    </div>
    {recent.map((pub) => <Publication pub={pub} />)}
  </section>
</Base>

<style>
  /* The charcoal band from the page header, full bleed behind the top of the
     lab photo, with the same gold rule; the photo sits over it. */
  .hero { position: relative; padding-top: 2.5rem; }
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 0;
    left: calc(50% - 50vw);
    width: 100vw;
    height: calc(2.5rem + var(--content-wide) * 0.4 * 0.6);
    background: var(--charcoal);
    border-bottom: 5px solid var(--gold);
  }
  .banner {
    /* Framed print: an even beige border, lifted off the band.
       content-box so the 5:2 shape belongs to the photo, not the frame. */
    --frame: 0.6rem;
    display: block;
    box-sizing: content-box;
    width: calc(100% - 2 * var(--frame));
    height: auto;
    aspect-ratio: 5 / 2;
    object-fit: cover;
    padding: var(--frame);
    background: var(--paper);
    box-shadow: 0 12px 32px color-mix(in srgb, var(--charcoal) 35%, transparent);
    margin-bottom: 2.5rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: 3rem;
    align-items: start;
  }
  @media (max-width: 56rem) {
    .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
  @media (max-width: 40rem) {
    .banner { --frame: 0.4rem; }
  }
  .hero h1 { margin-top: 0; margin-bottom: 0.25rem; }
  .expansion {
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
    color: var(--ink);
  }
  .expansion .cap { color: var(--brand); font-weight: 700; }
  .affil {
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 1.5rem;
  }
  .lede { font-size: 1.2rem; color: var(--ink-soft); margin-bottom: 0; }
  .areas { margin: 1.75rem 0 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .area-pill {
    display: inline-block;
    background: var(--brand);
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    border-radius: 999px;
    padding: 0.4rem 0.95rem;
    line-height: 1.2;
  }
  .area-pill:hover { background: var(--brand-deep); color: #fff; }

  /* Join card: charcoal so it pairs with, not repeats, the gold news panel. */
  .join {
    margin-top: 2.25rem;
    padding: 1.75rem 2rem;
    background: var(--charcoal);
    border-radius: 18px;
  }
  .join-kicker {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .join-quote { margin: 0.8rem 0 0.6rem; font-size: 1.45rem; line-height: 1.3; color: #fff; }
  .join-note { margin: 0 0 1.1rem; font-size: 1.05rem; color: var(--on-charcoal); }
  .join-link {
    display: inline-block;
    padding-bottom: 0.15rem;
    border-bottom: 2px solid var(--gold);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--gold);
    text-decoration: none;
  }
  .join-link:hover { color: #fff; border-bottom-color: #fff; }

  /* News feed: a dated list in the right column */
  /* A gold panel, the same as the culture card on /people. Brand blue is too
     light to read at small sizes on gold, so links here stay ink. */
  .news { background: var(--gold); border-radius: 18px; padding: 1.3125rem 1.5rem; }
  .news-heading {
    font-size: 0.875rem;
    text-transform: uppercase;
    color: var(--ink);
    font-weight: 700;
    letter-spacing: 0.14em;
    margin: 0 0 1rem;
  }
  .news-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .news-heading .news-all { font-weight: 700; color: var(--ink); text-decoration: none; }
  .news-heading .news-all:hover { text-decoration: underline; }
  .news-list { list-style: none; margin: 0; padding: 0; }
  .news-list li { display: flex; flex-direction: column; gap: 0.1rem; }
  .news-list li + li {
    margin-top: 0.675rem;
    padding-top: 0.675rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 40%, transparent);
  }
  .news-list time { font-size: 0.875rem; color: var(--ink); font-weight: 500; }
  .news-text { font-size: 1.1rem; line-height: 1.45; }
  .news-text a { color: var(--ink); text-decoration: none; }
  .news-text a:hover { text-decoration: underline; }

  /* Projects: a card grid in the wide column. Card styles live in ProjectCard.astro. */
  /* The first featured project leads at full width; the next two sit side by side. */
  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .projects :global(.lead) { grid-column: 1 / -1; }
  @media (max-width: 40rem) {
    .projects { grid-template-columns: minmax(0, 1fr); }
  }

  .people-group + .people-group { margin-top: 2.5rem; }
  .group-label {
    font-size: 0.92rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    font-weight: 600;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.5rem;
    margin-bottom: 1.75rem;
  }
  .people {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem 1.5rem;
  }
  .people :global(.person) { flex: 0 0 12.95rem; } /* fixed width, left-aligned; wide enough for two-word names on one line */

  /* Section titles match the other pages: same size, blue and gold bar under. */
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 3.5rem 0 1.5rem;
  }
  .section-head h2 {
    position: relative;
    margin: 0;
    padding-bottom: 0.6rem;
    font-size: clamp(1.9rem, 3vw, 2.25rem);
  }
  .section-head h2::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 4.5rem;
    height: 4px;
    /* two-tone: the lab's blue, then USM gold */
    background: linear-gradient(90deg, var(--brand) 50%, var(--gold) 50%);
  }
  .see-all { font-size: 0.9rem; white-space: nowrap; }
</style>
