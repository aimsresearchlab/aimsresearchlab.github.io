---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import { allProjects } from '../../data/projects';

const projects = await allProjects();
---
<Base
  title="Projects · AIMS Lab"
  description="Projects in the AIMS lab at the University of Southern Mississippi: LLM evaluation and conversational memory, RAG, AI agents, and computer vision."
>
  <PageHeader title="Projects">
    <p class="lede">
      We work on how machines see, remember, retrieve, and explain
      themselves, and on whether the results hold up when you look closely.
      Please click each project to learn more.
    </p>
  </PageHeader>
  <section class="wide">
    <div class="projects">
      {projects.map((project) => <ProjectCard project={project} cover />)}
    </div>
  </section>
</Base>

<style>
  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 2rem;
  }
</style>
