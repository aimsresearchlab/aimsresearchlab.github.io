---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { allProjects } from '../../data/projects';

const projects = await allProjects();
---
<Base title="Projects · AIMS Lab" description="...">
  <section class="hero">
    <div class="hero-inner">
      <h1>Projects</h1>
      <p class="lede">
        One card per line of work, not per paper. Each page collects the claim,
        the code, and the papers that came out of it.
      </p>
    </div>
  </section>
  <section class="wide">
    <div class="projects">
      {projects.map((project) => <ProjectCard project={project} cover />)}
    </div>
  </section>
</Base>

<style>
  .hero {
    background: #302f2c;
    color: #fff;
    border-bottom: 5px solid #ffcc33;
    margin: -3rem calc(50% - 50vw) 3rem;
  }
  .hero-inner {
    max-width: 1180px;
    margin: auto;
    padding: 3rem 1.5rem 2.5rem;
  }
  .hero h1 {
    font-family: 'Times New Roman', Times, serif;
    letter-spacing: -0.045em;
    line-height: 1.05;
    font-size: clamp(2.5rem, 4.5vw, 3.25rem);
    margin: 0 0 1rem;
    color: #fff;
  }
  .hero .lede {
    font-family: 'Times New Roman', Times, serif;
    font-size: 1.15rem;
    max-width: 42rem;
    color: #d6d5d0;
    margin: 0;
  }
  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 2rem;
  }
</style>
