---
import Base from '../layouts/Base.astro';
import Publication from '../components/Publication.astro';
import { publicationsByYear } from '../data/publications';

const byYear = publicationsByYear();
---
<Base title="Publications · AIMS Lab" description="Papers and preprints from the AIMS lab at the University of Southern Mississippi: LLM evaluation, conversational memory, RAG, AI agents, and thin-object segmentation.">
  <h1>Publications</h1>
  {byYear.map(([year, pubs]) => (
    <section>
      <h2>{year}</h2>
      {pubs.map((pub) => <Publication pub={pub} />)}
    </section>
  ))}
</Base>
