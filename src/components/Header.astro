---
// Site header: same markup/classes as the topbar on what-is-aims.astro,
// wired to the shared nav list + current-page detection so it renders
// identically on every page (Projects, People, News, Publications, ...).
const nav = [
  { label: 'Home', href: '/' },
  { label: 'What is AIMS?', href: '/what-is-aims/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Meet the Team', href: '/people/' },
  { label: 'News', href: '/news/' },
  { label: 'Publications', href: '/publications/' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href);
---
<header class="topbar">
  <nav class="nav" aria-label="Primary navigation">
    <div class="brand-lockup">
      <a class="aims-brand" href="/">
        <img
          class="brand-full"
          src="/assets/aims-lab-logo.png"
          alt="AIMS Lab: Artificial Intelligence and Multimodal Systems"
        />
      </a>
      <span class="cobrand-cross" aria-hidden="true">&#215;</span>
      <a class="usm-brand" href="https://www.usm.edu/">
        <img
          class="brand-usm"
          src="/usm-logo.svg"
          alt="The University of Southern Mississippi"
          width="147"
          height="57"
        />
      </a>
    </div>
    <div class="navlinks">
      {nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<style>
  .topbar {
    background: var(--paper);
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
  }
  .nav {
    width: var(--header-width);
    margin: auto;
    padding: 0.75rem 0;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  /* AIMS x USM, side by side: the lab mark, a thin cross, the university mark. */
  .brand-lockup { display: flex; align-items: center; gap: 0.9rem; margin-right: auto; }
  .aims-brand,
  .usm-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 70px;
  }
  .cobrand-cross {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--ink-soft);
    opacity: 0.55;
  }
  .brand-full { width: auto; height: 70px; }
  .brand-usm { width: auto; height: 52px; }
  .navlinks {
    display: flex;
    gap: 0.3rem;
    font-size: 1.05rem;
    font-weight: 700;
  }
  /* No boxes: the word itself carries the hover and the current-page marker. */
  .navlinks a {
    display: inline-block;
    padding: 0.5rem 0.75rem;
    white-space: nowrap; /* the lockup is wide; labels must not wrap */
    color: var(--ink-soft);
    text-decoration: none;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }
  .navlinks a:hover,
  .navlinks a:focus-visible {
    color: var(--ink);
    text-decoration: underline;
  }
  .navlinks a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--brand);
  }
  @media (max-width: 900px) {
    .nav { align-items: flex-start; flex-wrap: wrap; }
    .brand-lockup { margin-right: auto; }
    .navlinks { order: 3; width: 100%; overflow-x: auto; padding-top: 0.2rem; }
  }
  @media (max-width: 650px) {
    .nav { gap: 1rem; }
    .brand-lockup { gap: 0.5rem; }
    .aims-brand,
    .usm-brand { height: 50px; }
    .brand-full { width: auto; height: 49px; }
    .brand-usm { width: auto; height: 36px; }
    .cobrand-cross { font-size: 0.85rem; }
    .navlinks { gap: 0.2rem; font-size: 0.85rem; }
    .navlinks a { padding: 0.35rem 0.65rem; }
  }
</style>
