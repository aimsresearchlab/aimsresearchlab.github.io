---
// Site header: logo + primary nav. Edit nav items here.
// Section links point at homepage anchors so they work from any page.
const nav = [
  { label: 'Projects', href: '/#projects' },
  { label: 'People',   href: '/#people' },
  { label: 'News',     href: '/#news' },
  { label: 'Publications', href: '/publications' },
];
const path = Astro.url.pathname;
---
<header class="container wide site-header">
  <div class="brand-lockup">
    <a class="brand" href="/">
      <img src="/logo-mark.svg" alt="" width="30" height="30" />
      <span>AIMS</span>
    </a>
    <span class="divider" aria-hidden="true"></span>
    <a class="usm" href="https://www.usm.edu/" aria-label="University of Southern Mississippi">
      <img src="/usm-logo.svg" alt="USM" height="34" />
    </a>
  </div>
  <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="primary-navigation">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path class="menu-bars" d="M3 6h18M3 12h18M3 18h18" />
      <path class="menu-close" d="m6 6 12 12M6 18 18 6" />
    </svg>
  </button>
  <nav id="primary-navigation" class="ui" aria-label="Primary">
    {nav.map((item) => (
      <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const navigation = document.querySelector<HTMLElement>('#primary-navigation');
  const mobile = window.matchMedia('(max-width: 48rem)');

  if (toggle && navigation) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      navigation.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    navigation.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    mobile.addEventListener('change', () => setOpen(false));
  }
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 3rem;
  }
  .brand-lockup { display: inline-flex; align-items: center; gap: 1rem; }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
  }
  .divider {
    width: 1px;
    height: 34px;
    background: var(--rule);
  }
  .brand img { display: block; }
  .usm { display: inline-flex; align-items: center; }
  .usm img { height: 34px; width: auto; display: block; }
  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 0.25rem;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .menu-toggle:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; }
  .menu-close { display: none; }
  .menu-toggle[aria-expanded='true'] .menu-bars { display: none; }
  .menu-toggle[aria-expanded='true'] .menu-close { display: block; }
  nav {
    display: flex;
    gap: 1.5rem;
    font-size: 0.95rem;
  }
  nav a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--brand);
  }
  @media (max-width: 48rem) {
    .site-header { flex-wrap: wrap; }
    .brand-lockup { gap: 0.75rem; }
    .menu-toggle { display: inline-flex; }
    nav {
      display: none;
      flex-basis: 100%;
      flex-direction: column;
      gap: 0;
      padding-top: 0.5rem;
      border-top: 1px solid var(--rule);
    }
    nav.is-open { display: flex; }
    nav a { padding-block: 0.65rem; }
  }
</style>
