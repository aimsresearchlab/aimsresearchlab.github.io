---
// Site header — same markup/classes as the topbar on what-is-aims.astro,
// wired to the shared nav list + current-page detection so it renders
// identically on every page (Projects, People, News, Publications, ...).
const nav = [
  { label: 'Home', href: '/' },
  { label: 'What is AIMS?', href: '/what-is-aims/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Meet the Team', href: '/people/' },
  { label: 'News', href: '/news/' },
  { label: 'Publications', href: '/publications/' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href);
---
<header class="topbar">
  <nav class="nav" aria-label="Primary navigation">
    <div class="brand-lockup">
      <a class="usm-brand" href="https://www.usm.edu/computing-sciences-computer-engineering/index.php" aria-label="USM School of Computing Sciences and Computer Engineering">
        <img class="usm-logo" src="/assets/usm-horizontal-logo.png" alt="The University of Southern Mississippi" />
      </a>
      <span class="brand-divider" aria-hidden="true"></span>
      <a class="aims-brand" href="/">
        <img class="brand-full" src="/assets/aims-lab-logo.png" alt="AIMS Lab — Artificial Intelligence and Multimodal Systems" />
      </a>
    </div>
    <div class="navlinks">
      {nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<style>
  .topbar {
    background: #fff;
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
  }
  .nav {
    max-width: 1180px;
    margin: auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .brand-lockup { display: flex; align-items: center; gap: 1rem; margin-right: auto; }
  .usm-brand,
  .aims-brand {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 70px;
  }
  .usm-logo { width: 150px; height: auto; }
  .brand-divider { height: 52px; width: 1px; background: var(--rule); }
  .brand-full { width: auto; height: 70px; }
  .navlinks {
    display: flex;
    gap: 0.3rem;
    font-size: 1.05rem;
    font-weight: 700;
  }
  .navlinks a {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 0.4rem;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .navlinks a[aria-current='page'] { background: #111; color: #fff; }
  .navlinks a:hover { color: var(--ink); }
  @media (max-width: 900px) {
    .nav { align-items: flex-start; flex-wrap: wrap; }
    .brand-lockup { margin-right: auto; }
    .navlinks { order: 3; width: 100%; overflow-x: auto; padding-top: 0.2rem; }
  }
  @media (max-width: 650px) {
    .nav { gap: 1rem; }
    .brand-lockup { gap: 0.65rem; }
    .usm-brand, .aims-brand { height: 50px; }
    .brand-full { width: auto; height: 49px; }
    .brand-divider { height: 42px; }
    .usm-logo { width: 105px; }
    .navlinks { gap: 0.2rem; font-size: 0.85rem; }
    .navlinks a { padding: 0.35rem 0.65rem; }
  }
</style>
