---
import { Icon } from 'astro-icon/components';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container wide footer-inner ui">
    <span>© {year} AIMS · TEC 340, University of Southern Mississippi</span>
    <span class="links">
      <a href="https://github.com/aimsresearchlab" aria-label="GitHub"><Icon name="ph:github-logo" /></a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 2rem;
    background: var(--navy);
    color: #cdd6f4;
  }
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.9rem;
  }
  .links { display: inline-flex; gap: 1rem; font-size: 1.25rem; }
  .site-footer a { color: #cdd6f4; }
  .site-footer a:hover { color: #ffffff; }
</style>
