---
// Decorative "bookmark" ribbons hung from the top corners. They live in the
// empty margin either side of the centered content column, so they add brand
// weight without crowding the text. Purely decorative -> aria-hidden, and
// hidden on narrow screens where there is no margin to spare.
const grad = [
  { offset: '0',   color: '#0079FC' },
  { offset: '0.5', color: '#1652EC' },
  { offset: '1',   color: '#041A62' },
];
---
<div class="corner-ribbons" aria-hidden="true">
  <svg class="ribbon left" width="52" height="164" viewBox="0 0 52 164">
    <linearGradient id="ribbonL" x1="0" y1="0" x2="0" y2="1">
      {grad.map((s) => <stop offset={s.offset} stop-color={s.color} />)}
    </linearGradient>
    <polygon points="0,0 52,0 52,164 26,132 0,164" fill="url(#ribbonL)" />
  </svg>
  <svg class="ribbon right" width="52" height="164" viewBox="0 0 52 164">
    <linearGradient id="ribbonR" x1="0" y1="0" x2="0" y2="1">
      {grad.map((s) => <stop offset={s.offset} stop-color={s.color} />)}
    </linearGradient>
    <polygon points="0,0 52,0 52,164 26,132 0,164" fill="url(#ribbonR)" />
  </svg>
</div>

<style>
  .ribbon {
    position: absolute;
    top: 0;
    display: block;
    filter: drop-shadow(0 2px 3px rgba(4, 26, 98, 0.18));
  }
  .ribbon.left  { left: 3.5rem; }
  .ribbon.right { right: 3.5rem; }
  /* No spare margin below this width; hide so ribbons never overlap text. */
  @media (max-width: 64rem) {
    .corner-ribbons { display: none; }
  }
</style>
