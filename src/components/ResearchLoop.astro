---
// The six areas of the lab, drawn as one inline SVG instead of the 192KB
// raster it replaces. It scales to whatever column it sits in (the viewBox
// does the work, the <svg> itself has no fixed size), stays sharp at any size,
// and its colors come from the figure palette in global.css.
//
// Geometry: a 1200x760 canvas. The centre disc sits at (600, 380); the six
// cards ring it, three down each side, and the loop arrows run around the
// outside in reading order (perceive, reason, act, interact, trust,
// understand, back to perceive).
import { Icon } from 'astro-icon/components';

interface Area {
  key: string;       // the loop verb, drawn above the card
  color: string;     // css variable from the figure palette
  icon: string;      // Phosphor name
  title: string[];   // one entry per line
  body: string[];    // one entry per line, already wrapped
  x: number;         // card top-left
  y: number;
  labelAnchor: 'start' | 'end';
}

const CARD_W = 330;
const CARD_H = 172;

const areas: Area[] = [
  {
    key: 'Perceive',
    color: 'var(--area-perceive)',
    icon: 'ph:aperture',
    title: ['Artificial Intelligence', '& Computer Vision'],
    body: ['Enable machines to sense', 'and understand visual', 'information from the world.'],
    x: 40,
    y: 40,
    labelAnchor: 'start',
  },
  {
    key: 'Reason',
    color: 'var(--area-reason)',
    icon: 'ph:brain',
    title: ['Language Models', '& Agentic AI'],
    body: ['Build systems that reason,', 'plan, and act using language,', 'memory, and knowledge.'],
    x: 830,
    y: 40,
    labelAnchor: 'end',
  },
  {
    key: 'Understand',
    color: 'var(--area-understand)',
    icon: 'ph:graph',
    title: ['Multimodal &', 'Generative AI'],
    body: ['Learn and generate across', 'modalities to understand,', 'create, and reason jointly.'],
    x: 40,
    y: 294,
    labelAnchor: 'start',
  },
  {
    key: 'Act',
    color: 'var(--area-act)',
    icon: 'ph:robot',
    title: ['Edge AI &', 'Intelligent Systems'],
    body: ['Bring AI into the real world', 'through efficient, reliable,', 'adaptive systems.'],
    x: 830,
    y: 294,
    labelAnchor: 'end',
  },
  {
    key: 'Trust',
    color: 'var(--area-trust)',
    icon: 'ph:shield-check',
    title: ['Trustworthy &', 'Robust AI'],
    body: ['Recognize uncertainty,', 'withstand adversarial', 'conditions, stay calibrated.'],
    x: 40,
    y: 548,
    labelAnchor: 'start',
  },
  {
    key: 'Interact',
    color: 'var(--area-interact)',
    icon: 'ph:users-three',
    title: ['Human-Centered &', 'Affective AI'],
    body: ['Understand people, adapt to', 'their needs, and interact in', 'natural, aware ways.'],
    x: 830,
    y: 548,
    labelAnchor: 'end',
  },
];

// Where each card's connector meets the centre disc, and where it leaves the
// card. Left-hand cards connect on their right edge, right-hand cards on their
// left edge.
const CX = 600;
const CY = 380;
const R = 132;
const connectors = areas.map((a) => {
  const left = a.x < CX;
  const cardX = left ? a.x + CARD_W : a.x;
  const cardY = a.y + CARD_H / 2;
  const dx = cardX - CX;
  const dy = cardY - CY;
  const len = Math.hypot(dx, dy);
  return {
    color: a.color,
    x1: cardX,
    y1: cardY,
    x2: CX + (dx / len) * R,
    y2: CY + (dy / len) * R,
  };
});
---
<svg
  class="loop"
  viewBox="0 0 1200 760"
  role="img"
  aria-label="The six research areas of the AIMS lab and the loop they form: perceive, reason, act, interact, trust, and understand."
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    {areas.map((a) => (
      <marker
        id={`arrow-${a.key.toLowerCase()}`}
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" fill={a.color} />
      </marker>
    ))}
  </defs>

  {/* The loop itself: one arc per hop, running down the right side and back
      up the left, each arc carrying the colour of the area it points at. */}
  <g fill="none" stroke-width="3">
    <path d="M 374 126 C 500 98, 700 98, 826 126" stroke="var(--area-reason)" marker-end="url(#arrow-reason)" />
    <path d="M 995 216 L 995 288" stroke="var(--area-act)" marker-end="url(#arrow-act)" />
    <path d="M 995 470 L 995 542" stroke="var(--area-interact)" marker-end="url(#arrow-interact)" />
    <path d="M 826 634 C 700 662, 500 662, 374 634" stroke="var(--area-trust)" marker-end="url(#arrow-trust)" />
    <path d="M 205 542 L 205 470" stroke="var(--area-understand)" marker-end="url(#arrow-understand)" />
    <path d="M 205 288 L 205 216" stroke="var(--area-perceive)" marker-end="url(#arrow-perceive)" />
  </g>

  {/* Centre disc */}
  {connectors.map((c) => (
    <g>
      <line
        x1={c.x1}
        y1={c.y1}
        x2={c.x2}
        y2={c.y2}
        stroke={c.color}
        stroke-width="2"
        stroke-dasharray="6 6"
      />
      <circle cx={c.x2} cy={c.y2} r="5" fill="var(--paper)" stroke={c.color} stroke-width="2" />
    </g>
  ))}
  <circle cx={CX} cy={CY} r={R} fill="var(--paper)" stroke="var(--brand)" stroke-width="2" />
  <text class="mark" x={CX} y={CY - 42} text-anchor="middle">AIMS</text>
  <text class="expansion" x={CX} y={CY - 10} text-anchor="middle">Artificial Intelligence</text>
  <text class="expansion" x={CX} y={CY + 12} text-anchor="middle">&amp; Multimodal Systems</text>
  <line x1={CX - 76} y1={CY + 28} x2={CX + 76} y2={CY + 28} stroke="var(--rule)" stroke-width="1" />
  <text class="blurb" x={CX} y={CY + 52} text-anchor="middle">Intelligent systems that</text>
  <text class="blurb" x={CX} y={CY + 72} text-anchor="middle">perceive, understand, reason,</text>
  <text class="blurb" x={CX} y={CY + 92} text-anchor="middle">interact, and act reliably.</text>

  {/* The six cards */}
  {areas.map((a) => (
    <g>
      <text
        class="verb"
        x={a.labelAnchor === 'start' ? a.x + 4 : a.x + CARD_W - 4}
        y={a.y - 12}
        text-anchor={a.labelAnchor}
        fill={a.color}
      >
        {a.key.toUpperCase()}
      </text>
      <rect
        x={a.x}
        y={a.y}
        width={CARD_W}
        height={CARD_H}
        rx="14"
        fill="#fff"
        stroke={a.color}
        stroke-width="2"
      />
      <g transform={`translate(${a.x + 22}, ${a.y + 40})`} color={a.color}>
        <Icon name={a.icon} width="52" height="52" />
      </g>
      {a.title.map((line, i) => (
        <text class="card-title" x={a.x + 92} y={a.y + 42 + i * 24} fill={a.color}>{line}</text>
      ))}
      {a.body.map((line, i) => (
        <text class="card-body" x={a.x + 92} y={a.y + 100 + i * 21}>{line}</text>
      ))}
    </g>
  ))}
</svg>

<style>
  .loop {
    display: block;
    width: 100%;
    height: auto;
  }
  .loop text { font-family: var(--font-ui); }
  .mark {
    font-family: var(--font-serif);
    font-size: 46px;
    font-weight: 700;
    fill: var(--ink);
    letter-spacing: 0.02em;
  }
  .expansion { font-size: 16px; font-weight: 600; fill: var(--ink); }
  .blurb { font-size: 14px; fill: var(--ink-soft); }
  .verb { font-size: 16px; font-weight: 700; letter-spacing: 0.1em; }
  .card-title { font-size: 19px; font-weight: 700; }
  .card-body { font-size: 15px; fill: var(--ink-soft); }
</style>
