---
// Page decoration, behind the sheets and never on one, so the exported
// PowerPoint stays plain. The shapes are inert markup: deck.css gives them
// colour and deck-motion.ts drifts them when motion is allowed.
---

<div class="deck-field" aria-hidden="true">
  <span class="blob b1"></span>
  <span class="blob b2"></span>
  <span class="blob b3"></span>
  <span class="ring r1"></span>
  <span class="ring r2"></span>
  <span class="grid-veil"></span>
</div>
