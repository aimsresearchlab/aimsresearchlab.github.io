---
// The control bar in present mode. The data attributes are the contract with
// deck-present.ts; nothing here knows how the deck works.
import { Icon } from 'astro-icon/components';
interface Props {
  count: number;
}
const { count } = Astro.props;
---

<div class="stage-bar ui" hidden>
  <button type="button" data-prev aria-label="Previous slide"><Icon name="ph:caret-left" /></button>
  <span class="stage-count" data-count>1 / {count}</span>
  <button type="button" data-next aria-label="Next slide"><Icon name="ph:caret-right" /></button>
  <button type="button" data-auto aria-pressed="false">Auto</button>
  <button type="button" data-exit aria-label="Leave present mode"><Icon name="ph:x" /></button>
</div>
