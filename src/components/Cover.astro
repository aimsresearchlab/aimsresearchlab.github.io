---
// A 16:9 project cover. With no image or video, renders the placeholder (the
// AIMS mark on a hairline box) so the layout does not shift when a real
// cover lands.
// Real image covers: public/projects/<slug>.webp, 1600x900, quality 82.
// Real video covers: pass either the .webm or .mp4 path in `coverVideo`
// (public/projects/<slug>.{webm,mp4}, 1600x900 or any 16:9 size); the sibling
// with the other extension is expected to sit next to it, so both are served
// as <source> alternatives (Safari/iOS play the mp4, everyone else the webm).
// `src` still works as the poster frame shown before the video starts / if it
// fails to load, and as the reduced-motion fallback image below.
//
// `controls` adds the browser's native control bar (with its own fullscreen
// button). Leave it off for small card thumbnails; pass it on the project
// detail page where the cover is large.
//
// `compact` asks for the small, heavily compressed cut of the video, for the
// cards on / and /projects, where the cover renders about 300px wide and the
// full-size file is wasted bytes. The convention is a `-thumb` sibling next to
// the real file (public/projects/<name>-thumb.{webm,mp4}, 640x360). It is used
// only if it exists at build time, so a project without one still works. Make
// one with:
//
//   ffmpeg -i <name>.mp4 -vf scale=640:360 -an -c:v libx264 -crf 30 \
//     -preset slow -movflags +faststart <name>-thumb.mp4
//   ffmpeg -i <name>.webm -vf scale=640:360 -an -c:v libvpx-vp9 -crf 38 \
//     -b:v 0 -row-mt 1 <name>-thumb.webm
//
// Optional `caption` renders as a title bar over the bottom of the cover.
import { existsSync } from 'node:fs';

interface Props { src?: string; video?: string; alt?: string; caption?: string; controls?: boolean; compact?: boolean; }
const { src, video, alt = '', caption, controls = false, compact = false } = Astro.props;

// A public/ path that exists on disk, else undefined. Runs at build time only.
const onDisk = (path: string) =>
  existsSync(new URL(`../../public${path}`, import.meta.url)) ? path : undefined;

const pick = (path: string) => {
  if (!compact) return path;
  return onDisk(path.replace(/(\.\w+)$/, '-thumb$1')) ?? path;
};

// Only sources that are actually on disk: a project with just one of the two
// formats used to emit a <source> for the missing sibling, which every browser
// requested and got a 404 for before falling back.
const sibling = (ext: '.webm' | '.mp4') => {
  if (!video) return undefined;
  const path = video.endsWith(ext) ? video : video.replace(/\.(webm|mp4)$/, ext);
  return onDisk(path) && pick(path);
};
const webmSrc = sibling('.webm');
const mp4Src = sibling('.mp4');
---
{video ? (
  <div class="cover">
    {/* Shown instead of the video when the viewer has requested reduced
        motion; CSS alone can hide the <video>, but it cannot stop the
        autoplay/loop attributes from playing it, so this is a visual-only
        substitute, not a way to avoid decoding the video. */}
    <div class={`cover-fallback${src ? '' : ' cover-fallback-empty'}`} aria-hidden="true">
      {src ? (
        <img src={src} alt="" width="1600" height="900" />
      ) : (
        <img src="/logo-mark.svg" alt="" width="72" height="72" />
      )}
    </div>
    <video poster={src} autoplay muted loop playsinline preload="metadata" aria-label={alt} controls={controls}>
      {webmSrc && <source src={webmSrc} type="video/webm" />}
      {mp4Src && <source src={mp4Src} type="video/mp4" />}
    </video>
    {caption && (
      <div class="cover-caption"><p>{caption}</p></div>
    )}
  </div>
) : src ? (
  <div class="cover">
    <img src={src} alt={alt} width="1600" height="900" />
    {caption && (
      <div class="cover-caption"><p>{caption}</p></div>
    )}
  </div>
) : (
  <div class="cover cover-empty" aria-hidden="true">
    <img src="/logo-mark.svg" alt="" width="72" height="72" />
  </div>
)}

<style>
  .cover {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: #fff;
  }
  .cover img,
  .cover video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover-empty {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cover-empty { background: #fff; }
  .cover-empty img { width: 20%; max-width: 72px; height: auto; opacity: 0.12; }
  .cover-fallback {
    position: absolute;
    inset: 0;
    display: none;
  }
  .cover-fallback-empty {
    align-items: center;
    justify-content: center;
    background: #fff;
  }
  .cover-fallback-empty img { width: 20%; max-width: 72px; height: auto; opacity: 0.12; }
  @media (prefers-reduced-motion: reduce) {
    .cover video { display: none; }
    .cover-fallback { display: flex; }
  }
  .cover-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.7rem 0.85rem;
    background: rgba(255, 255, 255, 0.92);
    border-top: 1px solid var(--rule);
  }
  .cover-caption p {
    margin: 0;
    color: var(--ink);
    font-size: 0.72rem;
    line-height: 1.5;
  }
</style>
