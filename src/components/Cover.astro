---
// A 16:9 project cover. With no image, renders the placeholder (the AIMS mark
// on a hairline box) so the layout does not shift when a real cover lands.
// Real covers: public/projects/<slug>.webp, 1600x900, quality 82.
//
// Optional `caption` renders as a dark title bar over the bottom of the image.
interface Props { src?: string; alt?: string; caption?: string; }
const { src, alt = '', caption } = Astro.props;
---
{src ? (
  <div class="cover">
    <img src={src} alt={alt} width="1600" height="900" />
    {caption && (
      <div class="cover-caption"><p>{caption}</p></div>
    )}
  </div>
) : (
  <div class="cover cover-empty" aria-hidden="true">
    <img src="/logo-mark.svg" alt="" width="72" height="72" />
  </div>
)}

<style>
  .cover {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--rule);
    background: #fff;
  }
  .cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover-empty {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cover-empty { background: #fff; }
  .cover-empty img { width: 20%; max-width: 72px; height: auto; opacity: 0.12; }
  .cover-caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.7rem 0.85rem;
    background: rgba(19, 17, 15, 0.86);
  }
  .cover-caption p {
    margin: 0;
    color: #f3f1ec;
    font-size: 0.72rem;
    line-height: 1.5;
  }
</style>
